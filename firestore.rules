rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Any signed-in session (including anonymous, which the app signs everyone
    // into automatically) can read/write everything — matches the app's design
    // of full mutual visibility between logged-in employees. This just blocks
    // raw REST/curl access from outside the app, which previously had none.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
