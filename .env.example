# APP_URL: The URL where this app is hosted (https://gposouth-workout.vercel.app).
# Used for self-referential links (e.g. the LINE Flex Message's "view leaderboard" button).
APP_URL="MY_APP_URL"

# GOOGLE_APPS_SCRIPT_URL: Google Apps Script Web App deployment URL for direct Google Drive uploads
GOOGLE_APPS_SCRIPT_URL=""

# LINE_CHANNEL_ACCESS_TOKEN: LINE Messaging API Channel Access Token (for Flex Messages)
LINE_CHANNEL_ACCESS_TOKEN=""

# LINE_TARGET_ID: Optional LINE Group ID (Cxxx...) or User ID (Uxxx...) for push messages. If blank, sends via Broadcast.
LINE_TARGET_ID=""
